# ---- ربات معامله‌گر: نمونه‌ی متغیرهای محیطی ----
# این فایل را به .env کپی کنید. هیچ کلیدی را کامیت نکنید.

# ================= اتصال و نماد =================
# nobitex یا wallex
EXCHANGE=nobitex
# paper = شبیه‌سازی (پیش‌فرض و ایمن) | live = پول واقعی
TRADING_MODE=paper
# نماد بدون خط تیره: BTCIRT، ETHIRT، BTCUSDT ...
SYMBOL=BTCIRT

# ================= کلیدهای API صرافی =================
# نوبیتکس: توکن API از پنل «تنظیمات → API» (فقط Read + Trade، برداشت خاموش)
NOBITEX_API_TOKEN=
# والکس: کلید API (هدر x-api-key)
WALLEX_API_KEY=

# ================= تأیید معامله‌ی واقعی =================
# فقط وقتی دقیقاً برابر عبارت زیر باشد حالت live اجازه‌ی اجرا می‌گیرد
LIVE_TRADING_CONFIRM=

# ================= زمان‌بندی و اندیکاتورها =================
CYCLE_SECONDS=300
CANDLE_RESOLUTION=5
CANDLE_LOOKBACK=240
EMA_FAST=20
EMA_SLOW=50
EMA_TREND=200
RSI_PERIOD=14
ATR_PERIOD=14

# ================= مدیریت ریسک =================
MAX_POSITION_PCT=5
MAX_TOTAL_POSITION_PCT=15
MAX_DAILY_LOSS_PCT=3
MAX_TRADES_PER_DAY=8
COOLDOWN_MINUTES=30
STOP_LOSS_PCT=2
TAKE_PROFIT_PCT=4
MAX_SPREAD_PCT=1.5
MAX_SLIPPAGE_PCT=0.5
FEE_PCT=0.4
PAPER_SLIPPAGE_PCT=0.05
# حداقل ارزش هر سفارش (تومان برای بازار ریالی، دلار برای USDT) — خالی = خودکار
MIN_TRADE_QUOTE=
# سرمایه‌ی شروع شبیه‌سازی — خالی = ۱۰ میلیون تومان (یا ۵۰۰ دلار)
STARTING_CASH_QUOTE=
ORDER_FILL_TIMEOUT=30

# ================= ذخیره‌سازی و لاگ =================
STATE_DIR=state
LOG_LEVEL=INFO
HTTP_TIMEOUT=15
USER_AGENT=danesh-trader/0.1
TIMEZONE=Asia/Tehran

# ================= هوش مصنوعی (اختیاری) =================
LLM_ENABLED=false
# veto = فقط تأیید/وتوی تصمیم قاعده‌محور (پیشنهادی)
# independent = پیشنهاد مستقل مدل (ریسک بالاتر؛ سقف‌های ریسک همچنان اعمال می‌شود)
AI_DECISION_MODE=veto
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
AI_MIN_CONFIDENCE=0.6
LLM_TIMEOUT=30

# ================= تلگرام (اختیاری) =================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
