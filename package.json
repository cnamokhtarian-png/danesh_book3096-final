{
  "name": "daneshbook",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "game:dev": "npm --prefix polished-cat-street-game run dev",
    "game:build": "npm --prefix polished-cat-street-game run build && node scripts/copy-game.mjs",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:seed": "node scripts/seed.mjs",
    "db:set-admin": "node scripts/set-admin.mjs",
    "reset-link": "node scripts/reset-link.mjs",
    "db:create-reset-table": "node scripts/run-sql.mjs scripts/sql/001-password-resets.sql"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "16.4.3",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.31",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "version": "1.0.0",
  "description": "دانش‌بوک — بازار دانشجویی کتاب، جزوه و فایل‌های درسی (Next.js + PostgreSQL)"
}
