# ---- نمونه متغیرهای محیطی (این فایل را به .env کپی کنید) ----

# اتصال دیتابیس (Supabase / Postgres)
# قالب Supabase: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# حداکثر تعداد اتصال pool (پیش‌فرض ۵)
PG_POOL_MAX=5

# ---- اسکریپت ساخت حساب مدیر (npm run db:set-admin) ----
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=مدیر دانش‌بوک
ADMIN_EMAIL_DOMAIN=daneshbook.local

# ---- seed (فقط دیتابیس توسعه؛ هرگز روی تولید اجرا نکنید) ----
SEED_PASSWORD=
